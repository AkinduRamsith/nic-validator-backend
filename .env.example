# Mint Invoiz Backend Environment Variables

# Database Configuration
DB_USERNAME=mint_user
DB_PASSWORD=mint_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mint_invoiz_db

# JWT Configuration
JWT_SECRET=mintinvoiz-super-secret-key-change-in-production-2024

# Email Configuration (Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# File Storage
FILE_UPLOAD_DIR=./uploads

# Payment Gateway Configuration
# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# SMS Configuration (Twilio example)
SMS_PROVIDER=twilio
SMS_API_KEY=your-twilio-account-sid
SMS_API_SECRET=your-twilio-auth-token
SMS_FROM_NUMBER=+1234567890

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://mintinvoiz.com

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key

# Production Security
SECURITY_REQUIRE_SSL=false
SECURITY_CSRF_ENABLED=false